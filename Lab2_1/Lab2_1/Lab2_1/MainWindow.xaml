<Window x:Class="Lab2_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab2_1"
        mc:Ignorable="d"
        Title="TextEditor" Height="450" Width="800">
    <Window.Resources>
        <!-- Градієнтний пензель -->
        <LinearGradientBrush x:Key="LinearPanelBrush">
            <GradientStop Color="Yellow" Offset="0"/>
            <GradientStop Color="Aqua" Offset="0.5"/>
            <GradientStop Color="Yellow" Offset="1"/>
        </LinearGradientBrush>

        <!-- Стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="White"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Панель інструментів -->
        <Border Grid.Row="0" Background="{StaticResource LinearPanelBrush}" BorderThickness="2" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <Button ToolTip="Відкрити">
                    <Image Source="images\open.png" Width="100" Height="100"/>
                </Button>
                <Button ToolTip="Стерти">
                    <Image Source="images\clear.png" Width="100" Height="100"/>
                </Button>
                <Button ToolTip="Копіювати">
                    <Image Source="images\copy.png" Width="100" Height="100"/>
                </Button>
                <Button ToolTip="Вставити">
                    <Image Source="images\paste.png" Width="100" Height="100"/>
                </Button>
            </StackPanel>
        </Border>
        <!-- Текстова область -->
        <Border Grid.Row="1" Background="{StaticResource LinearPanelBrush}" BorderThickness="2" CornerRadius="10">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0" VerticalScrollBarVisibility="Visible"/>
                <!-- Додано Slider для розміру шрифту -->
                <DockPanel Grid.Row="1">
                    <Label DockPanel.Dock="Left" Content="Розмір шрифту:"/>
                    <Slider DockPanel.Dock="Left" Margin="4" MinWidth="100" 
            Name="fontSlider" Maximum="100" Minimum="12"/>
                    <Button HorizontalAlignment="Center" Content="ОК" Command="Save"/>
                </DockPanel>
                <!-- Прив'язка розміру шрифту TextBox до Slider -->
                <TextBox Grid.Row="0" VerticalScrollBarVisibility="Auto"
         FontSize="{Binding ElementName=fontSlider, Path=Value}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
    